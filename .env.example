# Copy to .env or run .\scripts\bootstrap.ps1 to detect these values.
TAILSCALE_IP=100.64.0.1
TAILSCALE_HOSTNAME=omen.example-tailnet.ts.net
# Bootstrap starts with the Tailscale IP. On Docker Desktop hosts that cannot
# listen there, it falls back to 0.0.0.0 only after validating Windows Firewall.
HOST_BIND_IP=100.64.0.1

ERGO_TLS_PORT=6697
THELOUNGE_PORT=9000
ERGO_NETWORK_NAME=OmenPrivateIRC
ERGO_ADMIN_ACCOUNT=admin
